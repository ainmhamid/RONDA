rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /User/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /User/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /Reviews/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /Places/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
