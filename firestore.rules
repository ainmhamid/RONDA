rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to check if a username exists during sign-up
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default rule for all other collections requires authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}